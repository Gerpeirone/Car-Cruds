# Entrada pública de la VM. Caddy obtiene y renueva el certificado HTTPS
# para PUBLIC_HOST. La API va directo al gateway, que autentica; el resto
# lo sirve la interfaz web estática.
{$PUBLIC_HOST} {
	encode zstd gzip

	# Las rutas internas (ready, metrics) no se publican. Debe ser un bloque
	# handle: un respond suelto se evalúa después y nunca se alcanzaría.
	handle /internal/* {
		respond 404
	}

	handle /v1/* {
		reverse_proxy gateway:8080
	}

	handle {
		reverse_proxy web:8080
	}

	log {
		output stdout
		format json
	}
}
