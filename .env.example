# Generar .env con: go run ./cmd/devsetup
# Las credenciales se generan localmente y nunca se versionan.
APP_PORT=8080
JAEGER_PORT=16686
SEED_DEMO=true
# Solo en la VM pública: nombre DNS para HTTPS (ver docs/DESPLIEGUE.md).
PUBLIC_HOST=
# Opcional: admisión simultánea del gateway (1–4096). Sin valor se usa 64 (ADR-013).
GATEWAY_MAX_IN_FLIGHT=
POSTGRES_PASSWORD=
CUSTOMERS_DB_PASSWORD=
RENTALS_DB_PASSWORD=
EMPLOYEES_DB_PASSWORD=
MONGO_ROOT_PASSWORD=
MONGO_FLEET_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=
AUTH_ADMIN_TOKEN=
AUTH_CLIENT_TOKEN=
AUTH_GYM_TOKEN=
AUTH_SERVICE_TOKEN=
# Base pública de Turnos para socios, por ejemplo https://hospital.example/v1.
# Sin URL se conserva el flujo local, pero submit/refresh devuelven 503.
CLINIC_BASE_URL=
# Clave emitida por el hospital para Car Cruds; obligatoria cuando se configura URL.
CLINIC_API_KEY=
CLINIC_ALLOW_HTTP=false
CLINIC_TIMEOUT=2s
