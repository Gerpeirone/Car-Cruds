                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Identidad de aplicación configurada fuera de Git. Autorización por rol en Empleados. Credenciales propias provisionales; no se utiliza demo-token del mock ni se afirma un acuerdo con equipos externos."
      }
    },
    "schemas": {
      "EmployeeSummary": {
        "type": "object",
        "additionalProperties": false,
        "example": {
          "employeeId": "employee-001",
          "displayName": "Persona ficticia de demostración Uno"
        },
        "required": [
          "employeeId",
          "displayName"
        ],
        "properties": {
          "employeeId": {
            "type": "string",
            "minLength": 1
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          }
        }
      },
      "Employee": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "employeeId",
          "displayName",
          "active"
        ],
        "properties": {
          "employeeId": {
            "type": "string",
            "minLength": 1
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "Candidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidateId",
          "displayName"
        ],
        "properties": {
          "candidateId": {
            "type": "string",
            "minLength": 1
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          }
        }
      },
      "EmployeeInput": {
        "type": "object",
        "additionalProperties": false,
        "example": {
          "displayName": "Nueva persona ficticia",
          "active": true
        },
        "required": [
          "displayName",
          "active"
        ],
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "CandidateInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "displayName"
        ],
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          }
        }
      },
      "EmployeePage": {
        "type": "object",
        "additionalProperties": false,
        "example": {
          "items": [
            {
              "employeeId": "employee-001",
              "displayName": "Persona ficticia de demostración Uno"
            },
            {
              "employeeId": "employee-002",
              "displayName": "Persona ficticia de demostración Dos"
            }
          ],
          "page": 1,
          "pageSize": 20,
          "total": 2
        },
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EmployeeSummary"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "AdminEmployeePage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Employee"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "CandidatePage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Candidate"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_INPUT",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "NOT_FOUND",
              "METHOD_NOT_ALLOWED",
              "UNSUPPORTED_MEDIA_TYPE",
              "SERVICE_UNAVAILABLE",
              "NOT_CONFIGURED"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      },
      "GymEnrollmentInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dni",
          "email"
        ],
        "properties": {
          "dni": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "GymEnrollment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enrollmentId",
          "employeeId",
          "state"
        ],
        "properties": {
          "enrollmentId": {
            "type": "string"
          },
          "employeeId": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "PENDING",
              "UNKNOWN",
              "ACCEPTED",
              "REJECTED"
            ]
          },
          "code": {
            "type": "string"
          },
          "socioId": {
            "type": "string"
          },
          "solicitudId": {
            "type": "string"
          },
          "providerRequestState": {
            "type": "string",
            "enum": [
              "PENDIENTE"
            ]
          },
          "membershipEnabled": {
            "type": "boolean",
            "enum": [
              false
            ]
          }
        }
      }
    }
  }
}
