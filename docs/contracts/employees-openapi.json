            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Página desde 1. Su desplazamiento debe caber en un entero de 64 bits; parámetro no repetible.",
