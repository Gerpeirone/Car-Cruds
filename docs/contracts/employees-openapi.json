        "operationId": "enrollEmployeeInGym",
        "summary": "Solicitar alta pendiente en gimnasio",
        "description": "Solo admin/service. Intención durable antes de HTTP; misma aplicación/clave/cuerpo recupera el snapshot original y referencias. No habilita membresía. DNI/email privados del trámite; no modifican la lista compartida.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GymEnrollmentInput"
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Datos inválidos o clave ausente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Identidad propia ausente o inválida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Solo admin/service.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Empleado/trámite inexistente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "201": {
            "description": "Alta aceptada; solicitud externa pendiente y membresía no habilitada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GymEnrollment"
                }
              }
            }
          },
          "202": {
            "description": "Intención durable cuyo envío está pendiente o en curso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GymEnrollment"
                }
              }
            }
          },
          "409": {
            "description": "GYM_ENROLLMENT_CONFLICT local, o rechazo externo durable.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/GymEnrollment"
                    }
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Resultado externo UNKNOWN con enrollmentId recuperable, o integración/persistencia no configurada/disponible.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/GymEnrollment"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/employees/{id}/gym-enrollments/{enrollment}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "description": "Identificador opaco propio."
        },
        {
          "name": "enrollment",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "get": {
        "operationId": "getGymEnrollment",
        "summary": "Consultar trámite privado sin llamar al proveedor",
        "description": "Solo admin/service; nunca devuelve DNI, email o clave privada. Un resultado UNKNOWN no prueba rechazo.",
        "responses": {
          "400": {
            "description": "Datos inválidos o clave ausente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Identidad propia ausente o inválida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Solo admin/service.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Empleado/trámite inexistente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "Estado durable del trámite.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GymEnrollment"
                }
              }
            }
          },
          "503": {
            "description": "Persistencia no disponible.",
            "content": {
