    "/v1/employees/clinic/requests/{requestId}/submit": {
      "parameters": [
        {
          "name": "requestId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      ],
      "post": {
        "summary": "Enviar o recuperar explícitamente la misma intención idempotente",
        "description": "Solo admin; sin cuerpo ni parámetros de consulta. Cada acción hace como máximo una llamada externa, respetando nextAttemptAt y Retry-After. Todo envío que pueda crear, incluido el reintento incierto, exige empleado activo. Se reutilizan clave y datos persistidos; no se exponen en la respuesta. Una solicitud terminal, con turno vinculado, conflicto idempotente o ya enviada bajo la API antigua sin procedencia idempotente no genera otro POST. El 200 describe el estado local. Ver COMUNICACION-HOSPITAL.md.",
        "responses": {
          "200": {
            "description": "Consultar estado y documentación de la operación.",
