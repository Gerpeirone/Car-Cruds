        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "ClinicRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "localReference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "personKind": {
            "type": "string",
            "enum": [
              "employee"
            ],
            "default": "employee",
            "description": "Campo conservado por compatibilidad; solo admite employee."
          },
          "personId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "patientId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "doctorId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "requestedStartAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "attemptedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "observedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "state": {
            "type": "string",
            "enum": [
              "ready",
              "unknown",
              "rejected",
              "booked",
              "cancelled"
            ]
          },
          "classification": {
            "type": "string",
            "enum": [
              "confirmed",
              "without_confirmed_appointment",
              "pending_verification"
            ]
          },
          "lastKnownAppointment": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "patientId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "doctorId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "startAt": {
                "type": "string",
                "format": "date-time"
              },
              "endAt": {
                "type": "string",
                "format": "date-time"
              },
              "status": {
                "type": "string",
                "enum": [
                  "booked",
                  "cancelled"
                ]
              },
              "version": {
                "type": "integer",
                "format": "int64",
                "minimum": 1
              }
            },
            "required": [
              "id",
              "patientId",
              "doctorId",
              "startAt",
              "endAt",
              "status",
              "version"
            ],
            "nullable": true
          },
          "failureCode": {
            "type": "string",
            "description": "Motivo administrativo acotado. CLINIC_UNAUTHORIZED, CLINIC_RATE_LIMITED, CLINIC_IDEMPOTENCY_CONFLICT, CLINIC_UNAVAILABLE y CLINIC_NOT_FOUND conservan resultado desconocido; no equivalen a rechazo de negocio."
          },
          "nextAttemptAt": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha opcional hasta la que se impide otro intento. No programa reintentos automáticos; su ausencia no garantiza que la solicitud sea reenviable."
          }
        },
        "required": [
          "requestId",
          "localReference",
          "personKind",
          "personId",
          "patientId",
          "doctorId",
          "requestedStartAt",
          "createdAt",
          "attemptedAt",
          "observedAt",
          "state",
          "classification",
          "lastKnownAppointment"
        ]
      },
      "PatientLink": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "personKind": {
            "type": "string",
            "enum": [
              "employee"
            ],
            "default": "employee",
            "description": "Campo conservado por compatibilidad; solo admite employee."
          },
          "personId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "patientId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "personKind",
          "personId",
          "patientId"
        ]
      },
      "CreateReview": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "personKind": {
            "type": "string",
            "enum": [
              "employee"
            ],
            "default": "employee",
            "description": "Campo conservado por compatibilidad; solo admite employee."
          },
          "personId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "localReference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "doctorId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "startAt": {
            "type": "string",
            "format": "date-time",
            "description": "Precisión de segundos, sin fracciones. No confirma una reserva."
          }
        },
        "required": [
          "personKind",
          "personId",
          "localReference",
          "doctorId",
          "startAt"
        ]
      },
      "Recovery": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "appointmentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": []
      },
      "ReportItem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "personKind": {
            "type": "string",
            "enum": [
              "employee"
            ],
            "default": "employee",
            "description": "Campo conservado por compatibilidad; solo admite employee."
          },
          "personId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "displayName": {
            "type": "string"
          },
          "active": {
            "type": "boolean",
            "nullable": true
          },
          "classification": {
            "type": "string",
            "enum": [
              "confirmed",
              "without_confirmed_appointment",
              "pending_verification"
            ]
          },
          "request": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "requestId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "localReference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "personKind": {
                "type": "string",
                "enum": [
                  "employee"
                ],
                "default": "employee",
                "description": "Campo conservado por compatibilidad; solo admite employee."
              },
              "personId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "patientId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "doctorId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "requestedStartAt": {
                "type": "string",
                "format": "date-time"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "attemptedAt": {
                "type": "string",
                "format": "date-time",
                "nullable": true
              },
              "observedAt": {
                "type": "string",
                "format": "date-time",
                "nullable": true
              },
              "state": {
                "type": "string",
                "enum": [
                  "ready",
                  "unknown",
                  "rejected",
                  "booked",
                  "cancelled"
                ]
              },
              "classification": {
                "type": "string",
                "enum": [
                  "confirmed",
                  "without_confirmed_appointment",
                  "pending_verification"
                ]
              },
              "lastKnownAppointment": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "patientId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "doctorId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "startAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "endAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "booked",
                      "cancelled"
                    ]
                  },
                  "version": {
                    "type": "integer",
                    "format": "int64",
                    "minimum": 1
                  }
                },
                "required": [
                  "id",
                  "patientId",
                  "doctorId",
                  "startAt",
                  "endAt",
                  "status",
                  "version"
                ],
                "nullable": true
              },
              "failureCode": {
                "type": "string",
                "description": "Motivo administrativo acotado; un error operativo conserva estado desconocido."
              },
              "nextAttemptAt": {
                "type": "string",
                "format": "date-time",
                "description": "Fecha opcional de espera antes de otra acción explícita; no programa reintentos automáticos."
              }
            },
            "required": [
              "requestId",
              "localReference",
              "personKind",
              "personId",
              "patientId",
              "doctorId",
              "requestedStartAt",
              "createdAt",
              "attemptedAt",
              "observedAt",
              "state",
              "classification",
              "lastKnownAppointment"
            ],
            "nullable": true
          }
        },
        "required": [
          "personKind",
          "personId",
          "displayName",
          "active",
          "classification",
          "request"
        ]
      },
      "Report": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportItem"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ]
      }
    }
  }
}
