{
  "openapi": "3.0.3",
  "info": {
    "title": "Car Cruds — Flota",
    "version": "0.1.0",
    "description": "Catálogo fuente en MongoDB, fichas con caché Redis y búsqueda derivada en Solr. El gateway distribuye las solicitudes entre dos réplicas mediante NGINX. Los importes se expresan en centavos de ARS. No existe DELETE: la baja se expresa con active=false mediante PUT."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "Gateway local predeterminado; ajustar al entorno de ejecución."
    }
  ],
  "tags": [
    {
      "name": "Flota",
      "description": "Operaciones del servicio de Flota."
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/vehicles": {
      "get": {
        "operationId": "listVehicles",
        "summary": "Listar el catálogo fuente",
        "description": "admin, client y service. Lee MongoDB sin depender de Solr; por defecto solo activos. includeInactive=true incluye inactivos únicamente para admin; para otros roles se ignora. El parámetro q es aceptado y validado por el lector común, pero no filtra esta operación: usar /search para buscar texto. Conteo e ítems provienen de consultas separadas; no hay snapshot común.",
        "tags": [
          "Flota"
        ],
        "x-roles": [
          "admin",
          "client",
          "service"
        ],
        "responses": {
          "200": {
            "description": "Página de vehículos obtenida de MongoDB con el conteo de coincidencias.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehiclePage"
                },
                "example": {
                  "items": [
                    {
                      "vehicleId": "auto-001",
                      "brand": "Toyota",
                      "model": "Corolla",
                      "category": "sedan",
                      "transmission": "manual",
                      "seats": 5,
                      "dailyRateMinor": 5000000,
                      "currency": "ARS",
                      "active": true,
                      "version": 1,
                      "updatedAt": "2026-10-28T12:00:00Z"
                    }
                  ],
                  "page": 1,
                  "pageSize": 20,
                  "total": 1
                }
              }
            }
          },
          "400": {
            "description": "INVALID_VEHICLE: identificador, campos de vehículo o filtros inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "INVALID_VEHICLE",
                  "message": "INVALID_VEHICLE: identificador, campos de vehículo o filtros inválidos."
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: credencial Bearer ausente, mal formada o inválida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "UNAUTHORIZED",
                  "message": "UNAUTHORIZED: credencial Bearer ausente, mal formada o inválida."
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN: aplicación autenticada sin el rol requerido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "FORBIDDEN",
                  "message": "FORBIDDEN: aplicación autenticada sin el rol requerido."
                }
              }
            }
          },
          "503": {
            "description": "FLEET_UNAVAILABLE: dependencia de Flota fallida; SOURCE_BUSY: límite de lectura; OUTBOX_FULL: cambios pendientes; SEARCH_UNAVAILABLE: índice no disponible; SERVICE_UNAVAILABLE: gateway/proxy no disponible.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "FLEET_UNAVAILABLE",
                  "message": "FLEET_UNAVAILABLE: dependencia de Flota fallida; SOURCE_BUSY: límite de lectura; OUTBOX_FULL: cambios pendientes; SEARCH_UNAVAILABLE: índice no disponible; SERVICE_UNAVAILABLE: gateway/proxy no disponible."
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Página desde 1.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000,
              "default": 1
            },
            "example": 1
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "Registros por página.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "example": 20
          },
          {
            "name": "brand",
            "in": "query",
            "required": false,
            "description": "Coincidencia exacta de marca, sensible a mayúsculas; se recortan espacios exteriores.",
            "schema": {
              "type": "string",
              "maxLength": 128
            },
            "example": "Toyota"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Coincidencia exacta de categoría; se recortan espacios exteriores.",
            "schema": {
              "type": "string",
              "maxLength": 64
            },
            "example": "sedan"
          },
          {
            "name": "transmission",
            "in": "query",
            "required": false,
            "description": "Filtro por transmisión.",
            "schema": {
              "type": "string",
              "enum": [
                "manual",
                "automatic"
              ]
            },
            "example": "manual"
          },
          {
            "name": "seats",
            "in": "query",
            "required": false,
            "description": "Coincidencia exacta de plazas; 0 u omisión desactiva el filtro.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "example": 5
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Orden por tarifa; vehicleId ascendente desempata.",
            "schema": {
              "type": "string",
              "enum": [
                "price_asc",
                "price_desc"
              ],
              "default": "price_asc"
            },
            "example": "price_asc"
          },
          {
            "name": "includeInactive",
            "in": "query",
            "required": false,
            "description": "Solo el literal true y el rol admin incluyen vehículos inactivos.",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "example": true
          }
        ]
      },
      "post": {
        "operationId": "createVehicle",
        "summary": "Registrar un vehículo y su cambio de catálogo",
        "description": "admin y service. Registra el vehículo con version=1 y su evento outbox en el mismo documento. active es opcional y por defecto true. version debe omitirse o ser 0. Campos desconocidos/duplicados se rechazan; la representación documentada es application/json, aunque este handler no verifica explícitamente Content-Type.",
        "tags": [
          "Flota"
        ],
        "x-roles": [
          "admin",
          "service"
        ],
        "responses": {
          "201": {
            "description": "Vehículo persistido en versión 1 con evento outbox pendiente de publicación.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Vehicle"
                },
                "example": {
                  "vehicleId": "auto-001",
                  "brand": "Toyota",
                  "model": "Corolla",
                  "category": "sedan",
                  "transmission": "manual",
                  "seats": 5,
                  "dailyRateMinor": 5000000,
                  "currency": "ARS",
                  "active": true,
                  "version": 1,
                  "updatedAt": "2026-10-28T12:00:00Z"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_VEHICLE: identificador, campos de vehículo o filtros inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "INVALID_VEHICLE",
                  "message": "INVALID_VEHICLE: identificador, campos de vehículo o filtros inválidos."
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: credencial Bearer ausente, mal formada o inválida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "UNAUTHORIZED",
                  "message": "UNAUTHORIZED: credencial Bearer ausente, mal formada o inválida."
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN: aplicación autenticada sin el rol requerido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "FORBIDDEN",
                  "message": "FORBIDDEN: aplicación autenticada sin el rol requerido."
                }
              }
            }
          },
          "409": {
            "description": "VERSION_CONFLICT: identificador duplicado o versión desactualizada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "VERSION_CONFLICT",
                  "message": "VERSION_CONFLICT: identificador duplicado o versión desactualizada."
                }
              }
            }
          },
          "503": {
            "description": "FLEET_UNAVAILABLE: dependencia de Flota fallida; SOURCE_BUSY: límite de lectura; OUTBOX_FULL: cambios pendientes; SEARCH_UNAVAILABLE: índice no disponible; SERVICE_UNAVAILABLE: gateway/proxy no disponible.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "FLEET_UNAVAILABLE",
                  "message": "FLEET_UNAVAILABLE: dependencia de Flota fallida; SOURCE_BUSY: límite de lectura; OUTBOX_FULL: cambios pendientes; SEARCH_UNAVAILABLE: índice no disponible; SERVICE_UNAVAILABLE: gateway/proxy no disponible."
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "description": "Objeto JSON de la operación. Los valores del ejemplo son ficticios.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateVehicle"
              },
              "example": {
                "vehicleId": "auto-001",
                "brand": "Toyota",
                "model": "Corolla",
                "category": "sedan",
                "transmission": "manual",
                "seats": 5,
                "dailyRateMinor": 5000000,
                "currency": "ARS",
                "active": true
              }
            }
          }
        }
      }
    },
    "/v1/vehicles/search": {
      "get": {
        "operationId": "searchVehicles",
        "summary": "Buscar vehículos en el índice Solr",
        "description": "admin, client y service. Busca texto y aplica filtros sobre la proyección derivada; siempre excluye inactivos. q se interpreta como texto escapado, sin aceptar sintaxis Lucene arbitraria. El índice puede retrasarse respecto de MongoDB: no autoriza precio ni reserva. Si Solr falla devuelve 503 SEARCH_UNAVAILABLE, sin reemplazar el fallo por una lista vacía.",
        "tags": [
          "Flota"
        ],
        "x-roles": [
          "admin",
          "client",
          "service"
        ],
        "responses": {
          "200": {
            "description": "Página de coincidencias del índice Solr, siempre de vehículos activos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehiclePage"
                },
                "example": {
                  "items": [
                    {
                      "vehicleId": "auto-001",
                      "brand": "Toyota",
                      "model": "Corolla",
                      "category": "sedan",
                      "transmission": "manual",
                      "seats": 5,
                      "dailyRateMinor": 5000000,
                      "currency": "ARS",
                      "active": true,
                      "version": 1,
                      "updatedAt": "2026-10-28T12:00:00Z"
                    }
                  ],
                  "page": 1,
                  "pageSize": 20,
                  "total": 1
                }
              }
            }
          },
          "400": {
            "description": "INVALID_VEHICLE: identificador, campos de vehículo o filtros inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "INVALID_VEHICLE",
                  "message": "INVALID_VEHICLE: identificador, campos de vehículo o filtros inválidos."
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: credencial Bearer ausente, mal formada o inválida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "UNAUTHORIZED",
                  "message": "UNAUTHORIZED: credencial Bearer ausente, mal formada o inválida."
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN: aplicación autenticada sin el rol requerido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "FORBIDDEN",
                  "message": "FORBIDDEN: aplicación autenticada sin el rol requerido."
                }
              }
            }
          },
          "503": {
            "description": "FLEET_UNAVAILABLE: dependencia de Flota fallida; SOURCE_BUSY: límite de lectura; OUTBOX_FULL: cambios pendientes; SEARCH_UNAVAILABLE: índice no disponible; SERVICE_UNAVAILABLE: gateway/proxy no disponible.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "SEARCH_UNAVAILABLE",
                  "message": "FLEET_UNAVAILABLE: dependencia de Flota fallida; SOURCE_BUSY: límite de lectura; OUTBOX_FULL: cambios pendientes; SEARCH_UNAVAILABLE: índice no disponible; SERVICE_UNAVAILABLE: gateway/proxy no disponible."
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Página desde 1.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000,
              "default": 1
            },
            "example": 1
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "Registros por página.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "example": 20
          },
          {
            "name": "brand",
            "in": "query",
            "required": false,
            "description": "Coincidencia exacta de marca, sensible a mayúsculas; se recortan espacios exteriores.",
            "schema": {
              "type": "string",
              "maxLength": 128
            },
            "example": "Toyota"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Coincidencia exacta de categoría; se recortan espacios exteriores.",
            "schema": {
              "type": "string",
              "maxLength": 64
            },
            "example": "sedan"
          },
          {
            "name": "transmission",
            "in": "query",
            "required": false,
            "description": "Filtro por transmisión.",
            "schema": {
              "type": "string",
              "enum": [
                "manual",
                "automatic"
              ]
            },
            "example": "manual"
          },
          {
            "name": "seats",
            "in": "query",
            "required": false,
            "description": "Coincidencia exacta de plazas; 0 u omisión desactiva el filtro.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "example": 5
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Orden por tarifa; vehicleId ascendente desempata.",
            "schema": {
              "type": "string",
              "enum": [
                "price_asc",
                "price_desc"
              ],
              "default": "price_asc"
            },
            "example": "price_asc"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Texto de búsqueda; se recortan espacios. Sin texto se buscan todos los vehículos activos.",
            "schema": {
              "type": "string",
              "maxLength": 256
            },
            "example": "Corolla"
          }
        ]
      }
    },
    "/v1/vehicles/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Identificador del vehículo.",
          "schema": {
            "$ref": "#/components/schemas/Identifier"
          },
          "example": "auto-001"
        }
      ],
      "get": {
        "operationId": "getVehicle",
        "summary": "Consultar la ficha de un vehículo",
        "description": "admin, client y service. Consulta Redis y, ante miss o error, MongoDB con tiempo y concurrencia acotados. La ficha puede conservar la vigencia de la caché; no debe usarse como tarifa autoritativa de confirmación. La consulta por identificador puede devolver un vehículo inactivo.",
        "tags": [
          "Flota"
        ],
        "x-roles": [
          "admin",
          "client",
          "service"
        ],
        "responses": {
          "200": {
            "description": "Ficha del vehículo, desde caché o fuente, con versión y fecha del cambio.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Vehicle"
                },
                "example": {
                  "vehicleId": "auto-001",
                  "brand": "Toyota",
                  "model": "Corolla",
                  "category": "sedan",
                  "transmission": "manual",
                  "seats": 5,
                  "dailyRateMinor": 5000000,
                  "currency": "ARS",
                  "active": true,
                  "version": 1,
                  "updatedAt": "2026-10-28T12:00:00Z"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_VEHICLE: identificador, campos de vehículo o filtros inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "INVALID_VEHICLE",
                  "message": "INVALID_VEHICLE: identificador, campos de vehículo o filtros inválidos."
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: credencial Bearer ausente, mal formada o inválida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "UNAUTHORIZED",
                  "message": "UNAUTHORIZED: credencial Bearer ausente, mal formada o inválida."
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN: aplicación autenticada sin el rol requerido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "FORBIDDEN",
                  "message": "FORBIDDEN: aplicación autenticada sin el rol requerido."
                }
              }
            }
          },
          "404": {
            "description": "VEHICLE_NOT_FOUND: vehículo inexistente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "VEHICLE_NOT_FOUND",
                  "message": "VEHICLE_NOT_FOUND: vehículo inexistente."
                }
              }
            }
          },
          "503": {
            "description": "FLEET_UNAVAILABLE: dependencia de Flota fallida; SOURCE_BUSY: límite de lectura; OUTBOX_FULL: cambios pendientes; SEARCH_UNAVAILABLE: índice no disponible; SERVICE_UNAVAILABLE: gateway/proxy no disponible.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "FLEET_UNAVAILABLE",
                  "message": "FLEET_UNAVAILABLE: dependencia de Flota fallida; SOURCE_BUSY: límite de lectura; OUTBOX_FULL: cambios pendientes; SEARCH_UNAVAILABLE: índice no disponible; SERVICE_UNAVAILABLE: gateway/proxy no disponible."
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "updateVehicle",
        "summary": "Actualizar un vehículo con control de versión",
        "description": "admin y service. Sustituye marca, modelo, categoría, transmisión, plazas, tarifa y moneda. Requiere version vigente; una carrera produce 409 VERSION_CONFLICT. vehicleId es opcional en el cuerpo y, si aparece, debe coincidir con la ruta. active omitido o null conserva el estado actual; active=false produce baja lógica. Guarda cambio y outbox, incrementa versión e intenta invalidar caché. No admite Idempotency-Key.",
        "tags": [
          "Flota"
        ],
        "x-roles": [
          "admin",
          "service"
        ],
        "responses": {
          "200": {
            "description": "Nueva versión del vehículo persistida con su evento outbox.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Vehicle"
                },
                "example": {
                  "vehicleId": "auto-001",
                  "brand": "Toyota",
                  "model": "Corolla",
                  "category": "sedan",
                  "transmission": "manual",
                  "seats": 5,
                  "dailyRateMinor": 5500000,
                  "currency": "ARS",
                  "active": true,
                  "version": 2,
                  "updatedAt": "2026-10-28T12:00:00Z"
                }
              }
            }
