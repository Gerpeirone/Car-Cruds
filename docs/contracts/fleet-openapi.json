            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "UNAUTHORIZED",
                  "message": "UNAUTHORIZED: credencial Bearer ausente, mal formada o inválida."
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN: aplicación autenticada sin el rol requerido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "FORBIDDEN",
                  "message": "FORBIDDEN: aplicación autenticada sin el rol requerido."
                }
              }
            }
          },
          "404": {
            "description": "VEHICLE_NOT_FOUND: vehículo inexistente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "VEHICLE_NOT_FOUND",
                  "message": "VEHICLE_NOT_FOUND: vehículo inexistente."
                }
              }
