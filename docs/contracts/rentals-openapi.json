    "/v1/reservations": {
      "post": {
        "tags": [
          "Reservas"
        ],
        "operationId": "createRentalReservation",
        "summary": "Confirmar una reserva idempotente",
        "description": "Roles admin y service pueden reservar para cualquier cliente; client solo para su CustomerID autenticado. El cliente debe estar activo y su licencia cubrir al menos el último día ocupado (endsOn − 1 día). El vehículo debe estar activo y el importe esperado coincidir con tarifa diaria × días. La aplicación de origen queda asociada internamente a la reserva y no se recibe como dato del cuerpo. Agenda y respuesta idempotente se confirman en una transacción local. Una exclusión PostgreSQL impide reservas o mantenimientos solapados, también entre instancias. La clave se delimita por aplicación autenticada + operación de creación + Idempotency-Key. Misma clave y los mismos valores de los cinco campos, aunque cambien el orden JSON o los espacios, recuperan el estado HTTP y la respuesta originales antes de revalidar fechas, cliente o tarifa. Una reserva cancelada, retirada o devuelta conserva la respuesta original RESERVED de su creación; GET obtiene su estado actual. Otra carga con la misma clave produce 409 IDEMPOTENCY_KEY_REUSED. Se conservan también los rechazos de negocio registrados (fechas inválidas, recurso inexistente, precio, agenda o habilitación); para corregir la intención se usa una clave nueva. Errores de autenticación, permisos, formato, clave y tipo de contenido se resuelven antes de registrar la intención. Una falla técnica antes del commit no consume la clave. Ante respuesta perdida o 503, reintentar la misma intención con la misma clave para recuperar un posible commit. La retención es durable, atraviesa reinicios y actualmente no tiene purga automática.",
        "x-roles": [
          "admin",
          "client",
          "service"
        ],
        "x-idempotency-scope": [
          "authenticated-application",
          "create-reservation",
          "Idempotency-Key"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Objeto JSON único de hasta 1 MiB. Los nombres de campos son exactos; no se admiten null, propiedades desconocidas o duplicadas, otro valor JSON ni datos posteriores.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateReservation"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Reserva confirmada en estado RESERVED o respuesta original de una repetición idempotente. Ambas devuelven 201.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Reservation"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "RESERVED"
                          ]
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "id": "d30c48bb-e7aa-4b6d-a69f-83fbbe07c77f",
                  "status": "RESERVED",
                  "vehicleId": "auto-001",
                  "customerId": "cli-001",
                  "startsOn": "2030-01-15",
                  "endsOn": "2030-01-18",
                  "days": 3,
                  "dailyRateMinor": 5000000,
                  "totalMinor": 15000000,
                  "currency": "ARS"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidInput"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "NOT_FOUND: cliente o vehículo inexistente.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "NOT_FOUND"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "PRICE_CHANGED: el total autoritativo difiere del esperado. VEHICLE_UNAVAILABLE: vehículo inactivo o período ocupado. IDEMPOTENCY_KEY_REUSED: la clave ya pertenece a otra carga.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "PRICE_CHANGED",
                            "VEHICLE_UNAVAILABLE",
                            "IDEMPOTENCY_KEY_REUSED"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "415": {
            "description": "UNSUPPORTED_MEDIA_TYPE: Content-Type ausente o distinto de application/json. Se admiten parámetros del tipo de contenido, como charset=utf-8.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "UNSUPPORTED_MEDIA_TYPE"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "CUSTOMER_NOT_ELIGIBLE: cliente inactivo o licencia insuficiente para el período.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "CUSTOMER_NOT_ELIGIBLE"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/DependencyUnavailable"
          }
        }
      }
    },
