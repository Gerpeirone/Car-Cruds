                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "VEHICLE_UNAVAILABLE: el mantenimiento se solapa con una ocupación existente.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "VEHICLE_UNAVAILABLE"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/DependencyUnavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Credencial opaca de aplicación enviada como Authorization: Bearer <token>. La configuración local resuelve aplicación, rol y CustomerID; no se aceptan estos atributos desde el cuerpo ni se presupone JWT. Todas las operaciones requieren autenticación. gym no está autorizado a Alquileres."
      }
    },
    "parameters": {
      "VehicleIdQuery": {
        "name": "vehicleId",
        "in": "query",
        "required": true,
        "description": "Identificador del vehículo; exactamente una aparición.",
        "schema": {
          "$ref": "#/components/schemas/Identifier"
        },
        "example": "auto-001"
      },
      "StartsOnQuery": {
        "name": "startsOn",
        "in": "query",
        "required": true,
        "description": "Inicio incluido, igual o posterior a hoy en America/Buenos_Aires; exactamente una aparición.",
        "schema": {
          "$ref": "#/components/schemas/Date"
        },
        "example": "2030-01-15"
      },
      "EndsOnQuery": {
        "name": "endsOn",
        "in": "query",
        "required": true,
        "description": "Fin excluido; duración de 1 a 30 días calendario; exactamente una aparición.",
        "schema": {
          "$ref": "#/components/schemas/Date"
        },
        "example": "2030-01-18"
      },
      "ReservationId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Identificador de reserva. Un identificador mal formado se responde con NOT_FOUND.",
        "schema": {
          "$ref": "#/components/schemas/Identifier"
        },
        "example": "d30c48bb-e7aa-4b6d-a69f-83fbbe07c77f"
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Una sola aparición; de 1 a 128 caracteres ASCII visibles, sin espacios. Delimita la intención dentro de la aplicación y la operación de creación.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]{1,128}$"
        },
        "example": "reserva-cli-001-2030-01-15-01"
      }
    },
    "schemas": {
      "Identifier": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
        "description": "Identificador sensible a mayúsculas y minúsculas."
      },
      "Date": {
        "type": "string",
        "format": "date",
        "minLength": 10,
        "maxLength": 10,
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
        "description": "Fecha calendario válida YYYY-MM-DD, sin hora ni desplazamiento. Los períodos se interpretan en America/Buenos_Aires."
      },
      "CreateReservation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "vehicleId",
          "customerId",
          "startsOn",
          "endsOn",
          "expectedTotalMinor"
        ],
        "properties": {
          "vehicleId": {
            "$ref": "#/components/schemas/Identifier"
          },
          "customerId": {
            "$ref": "#/components/schemas/Identifier"
          },
          "startsOn": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Date"
              }
            ],
            "description": "Inicio incluido. En una solicitud nueva debe ser igual o posterior a la fecha actual de America/Buenos_Aires."
          },
          "endsOn": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Date"
              }
            ],
            "description": "Fin excluido. La diferencia de días calendario respecto de startsOn debe estar entre 1 y 30."
          },
          "expectedTotalMinor": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Total esperado en centavos de ARS; entero de 64 bits. Debe coincidir con la tarifa autoritativa multiplicada por los días."
          }
        },
        "example": {
          "vehicleId": "auto-001",
          "customerId": "cli-001",
          "startsOn": "2030-01-15",
          "endsOn": "2030-01-18",
          "expectedTotalMinor": 15000000
        }
      },
      "Reservation": {
        "type": "object",
        "required": [
          "id",
          "status",
          "vehicleId",
          "customerId",
          "startsOn",
          "endsOn",
          "days",
          "dailyRateMinor",
          "totalMinor",
          "currency"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "status": {
            "type": "string",
            "enum": [
              "RESERVED",
              "ACTIVE",
              "COMPLETED",
              "CANCELLED"
            ],
            "description": "Transiciones: RESERVED → ACTIVE → COMPLETED; RESERVED → CANCELLED. COMPLETED y CANCELLED son finales."
          },
          "vehicleId": {
            "$ref": "#/components/schemas/Identifier"
          },
          "customerId": {
            "$ref": "#/components/schemas/Identifier"
          },
          "startsOn": {
            "$ref": "#/components/schemas/Date"
          },
          "endsOn": {
            "$ref": "#/components/schemas/Date"
          },
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "description": "Días calendario del período semiabierto [startsOn, endsOn)."
          },
          "dailyRateMinor": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "Tarifa diaria congelada al confirmar; entero de 64 bits expresado en centavos de ARS."
          },
          "totalMinor": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "dailyRateMinor × days; entero de 64 bits expresado en centavos de ARS."
          },
          "currency": {
            "type": "string",
            "enum": [
              "ARS"
            ]
          }
        },
        "description": "Precio congelado al confirmar. El cliente y vehículo son referencias a servicios propios; la aplicación propietaria no se expone. El objeto puede incorporar campos adicionales compatibles."
      },
      "Availability": {
        "type": "object",
        "required": [
          "vehicleId",
          "startsOn",
          "endsOn",
          "available",
          "days",
          "dailyRateMinor",
          "totalMinor",
          "currency"
        ],
        "properties": {
          "vehicleId": {
            "$ref": "#/components/schemas/Identifier"
          },
          "startsOn": {
            "$ref": "#/components/schemas/Date"
          },
          "endsOn": {
            "$ref": "#/components/schemas/Date"
          },
          "available": {
            "type": "boolean"
          },
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "description": "Días calendario del período semiabierto [startsOn, endsOn)."
          },
          "dailyRateMinor": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "Tarifa diaria congelada al confirmar; entero de 64 bits expresado en centavos de ARS."
          },
          "totalMinor": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "dailyRateMinor × days; entero de 64 bits expresado en centavos de ARS."
          },
          "currency": {
            "type": "string",
            "enum": [
              "ARS"
            ]
          },
          "unavailableReason": {
            "type": "string",
            "enum": [
              "VEHICLE_INACTIVE",
              "OVERLAPPING_RESERVATION"
            ],
            "description": "Solo se devuelve cuando available=false. OVERLAPPING_RESERVATION incluye ocupación por reserva o mantenimiento."
          }
        },
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "available": {
                "type": "boolean",
                "enum": [
                  true
                ]
              }
            },
            "not": {
              "required": [
                "unavailableReason"
              ]
            }
          },
          {
            "type": "object",
            "required": [
              "unavailableReason"
            ],
            "properties": {
              "available": {
                "type": "boolean",
                "enum": [
                  false
                ]
              }
            }
          }
        ],
        "description": "Consulta informativa: puede informar indisponibilidad con precio válido; una dependencia fallida devuelve 503 en lugar de available=false."
      },
      "CreateMaintenance": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "vehicleId",
          "startsOn",
          "endsOn"
        ],
        "properties": {
          "vehicleId": {
            "$ref": "#/components/schemas/Identifier"
          },
          "startsOn": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Date"
              }
            ],
            "description": "Inicio incluido. En una solicitud nueva debe ser igual o posterior a la fecha actual de America/Buenos_Aires."
          },
          "endsOn": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Date"
              }
            ],
            "description": "Fin excluido. La diferencia de días calendario respecto de startsOn debe estar entre 1 y 30."
          }
        },
        "example": {
          "vehicleId": "auto-001",
          "startsOn": "2030-01-20",
          "endsOn": "2030-01-22"
        }
      },
      "Maintenance": {
        "type": "object",
        "required": [
          "id",
          "vehicleId",
          "startsOn",
          "endsOn"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "vehicleId": {
            "$ref": "#/components/schemas/Identifier"
          },
          "startsOn": {
            "$ref": "#/components/schemas/Date"
          },
          "endsOn": {
            "$ref": "#/components/schemas/Date"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "UNAUTHORIZED",
              "FORBIDDEN",
              "INVALID_INPUT",
              "NOT_FOUND",
              "PRICE_CHANGED",
              "VEHICLE_UNAVAILABLE",
              "IDEMPOTENCY_KEY_REUSED",
              "INVALID_STATE",
              "CUSTOMER_NOT_ELIGIBLE",
              "DEPENDENCY_UNAVAILABLE",
              "SERVICE_UNAVAILABLE",
              "UNSUPPORTED_MEDIA_TYPE",
              "METHOD_NOT_ALLOWED"
            ]
          },
          "message": {
            "type": "string",
            "description": "Descripción legible del error. El consumidor debe decidir por code y estado HTTP; el texto puede cambiar."
          }
        }
      }
    },
    "responses": {
      "InvalidInput": {
        "description": "INVALID_INPUT: identificador, fecha, período, importe, parámetros, clave o cuerpo JSON inválidos. Un cuerpo admite exactamente un objeto, sin campos desconocidos ni duplicados y hasta 1 MiB.",
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/Error"
                },
                {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "INVALID_INPUT"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "Unauthorized": {
        "description": "UNAUTHORIZED: falta una credencial Bearer válida de aplicación.",
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/Error"
                },
                {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "UNAUTHORIZED"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "Forbidden": {
        "description": "FORBIDDEN: el rol no está autorizado o la aplicación no puede operar para ese cliente.",
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/Error"
                },
                {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "FORBIDDEN"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "DependencyUnavailable": {
        "description": "DEPENDENCY_UNAVAILABLE: almacenamiento o dependencia interna no disponible o respuesta inválida. SERVICE_UNAVAILABLE: el gateway no puede atender o alcanzar el servicio. El resultado de un comando puede ser indeterminado para el solicitante; recuperar mediante la clave idempotente cuando corresponda.",
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/Error"
                },
                {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "DEPENDENCY_UNAVAILABLE",
                        "SERVICE_UNAVAILABLE"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "ReservationNotFound": {
        "description": "NOT_FOUND: recurso inexistente. La lectura de una reserva ajena por el rol client también devuelve 404.",
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/Error"
                },
                {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "NOT_FOUND"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "MethodNotAllowed": {
        "description": "METHOD_NOT_ALLOWED: método u operación no admitidos para una ruta de reserva.",
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/Error"
                },
                {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "METHOD_NOT_ALLOWED"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
