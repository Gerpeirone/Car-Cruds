        "x-roles": [
          "admin",
          "service"
        ],
        "requestBody": {
          "required": true,
          "description": "Objeto JSON único de hasta 1 MiB. Los nombres de campos son exactos; no se admiten null, propiedades desconocidas o duplicadas, otro valor JSON ni datos posteriores.",
